# Copy this file to .env. Keep real credentials out of Git.
MODEL_API_KEY=
META_API_URL=https://api.meta.ai/v1/responses
META_MODEL=muse-wonder-1.0
META_EFFORT=low
CONF_MIN=0.7
PORT=3000
API_RATE_LIMIT=20
# Maximum analyses per UTC day; set to 0 only to disable the cap.
DAILY_ANALYSIS_LIMIT=100
# Optional patient-facing demo code. Keep it out of URLs and source control.
DEMO_ACCESS_CODE=
# Must match PHARMA_NODE_TOKEN in the C relay environment.
INTERNAL_RELAY_TOKEN=

# Local C relay. Match RELAY_TOKEN with PHARMA_TOKEN in the C process.
RELAY_URL=http://127.0.0.1:8080
RELAY_TOKEN=

# Optional direct HTTPS. Set both paths, or leave both empty for local HTTP.
TLS_CERT_FILE=
TLS_KEY_FILE=
# If behind a reverse proxy, trust only its known IP/range, e.g. loopback.
TRUST_PROXY=

# Set to 1 to return a clearly marked simulated result without calling Meta.
PHARMA_MOCK=0
